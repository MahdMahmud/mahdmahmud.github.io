@unpublished{mahmud2026forbearance,
  title={A Life-Cycle Model of Mortgage Debt Relief: Refinancing and Forbearance during the COVID-19 Pandemic},
  author={Mahmud, Mahd},
  year={2026},
  month={September},
  note={Work in progress. This draft is preliminary and incomplete. Please do not cite, quote, or distribute without the author's consent. Comments are welcome.},
  pdf={mahmud_mortgage_forbearance_2026.pdf},
  abstract={When a crisis impacts households' mortgage obligations, relief can work through prices or through eligibility; by allowing borrowers to modify their mortgage debt or defer their payments, respectively. The COVID-19 response used both: a policy-rate cut transmitted through refinancing, which requires contemporaneous re-underwriting, and CARES forbearance, which gave eligible borrowers payment relief on request without it. This paper asks which borrowers each instrument reaches, and whether relief changes who defaults or only when. We study a partial-equilibrium life-cycle heterogeneous-agent model of mortgage choice with underwriting frictions, a multi-period delinquency bridge, non-recourse default, and a forbearance option whose length is governed by a within-year re-employment hazard rather than chosen---disciplined to the 2019 Survey of Consumer Finances and the 2020 mortgage market.},
  selected={true}
}
